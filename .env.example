# Root environment — used only by the Supabase CLI (link / db push / gen types).
# Copy to `.env` and fill in real values. Do NOT commit `.env`.
#
# These let you run the CLI non-interactively. You can also just pass them on
# the command line when running `supabase link` / `supabase db push`.

# Personal access token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Your project ref (the subdomain of your project URL), e.g. abcdefghijklmno
SUPABASE_PROJECT_REF=

# Database password (set when you created the project) — used by `db push`.
SUPABASE_DB_PASSWORD=
