# API server environment.
# Copy to `.env` and fill in real values. Do NOT commit `.env`.
# These are server-only secrets and must never be shipped to the mobile app.

# --- Supabase (server-side, secret key bypasses Row Level Security) ---------
# Same project URL as the mobile app.
SUPABASE_URL=
# Secret key from Supabase dashboard (Project Settings -> API keys).
# Looks like: sb_secret_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=

# --- Existing server config (already used by the app; documented here) ------
# HTTP port the Express server listens on.
PORT=3000

# Octopus Energy API (see src/lib/octopus.ts).
OCTOPUS_API_KEY=
OCTOPUS_ELECTRICITY_MPAN=
OCTOPUS_ELECTRICITY_SERIAL=
OCTOPUS_GAS_MPRN=
OCTOPUS_GAS_SERIAL=

# Google Gemini (AI chat).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Postgres connection string used by @workspace/db (Drizzle).
# For Supabase this is the Connection string from Project Settings -> Database.
DATABASE_URL=
