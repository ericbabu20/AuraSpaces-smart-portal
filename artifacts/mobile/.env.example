# Mobile (Expo) environment.
# Copy to `.env` and fill in real values. Do NOT commit `.env`.
#
# Only EXPO_PUBLIC_* vars are exposed to the app bundle. The mobile app must
# ONLY ever use the publishable key (sb_publishable_...). Never put a secret
# (sb_secret_...) key here.

# Your Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key from Supabase dashboard (Project Settings -> API keys).
# Looks like: sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
